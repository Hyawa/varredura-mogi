{
  "name": "varredura-mogi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "build/main.mjs",
  "description": "Verificador sob demanda de concursos e processos seletivos abertos em Mogi Mirim",
  "author": "Varredura Mogi",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "scan": "npm run build:node && node --use-system-ca build/cli.mjs",
    "build:node": "node scripts/build-node.mjs",
    "fixtures": "node --use-system-ca scripts/fetch-fixtures.mjs",
    "electron": "npm run build:node && electron build/main.mjs",
    "electron:dev": "npm run build && npm run build:node && electron build/main.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "smoke:electron": "npm run build && npm run build:node && electron scripts/smoke-electron.mjs",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "npm run build && cap run android",
    "dist:win": "npm run build && npm run build:node && electron-builder --win",
    "dist:win:dir": "npm run build && npm run build:node && electron-builder --win --dir",
    "icone": "electron scripts/gerar-icone.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "lucide-react": "^1.72.0",
    "node-html-parser": "^9.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
